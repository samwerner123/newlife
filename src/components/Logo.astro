---
import { SITE } from '../config';
---

<a href="/" class="logo" aria-label={`${SITE.name} home`}>
  <svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#0d366b"></rect>
    <circle cx="32" cy="32" r="11" fill="#eb6834"></circle>
    <g stroke="#eb6834" stroke-width="4" stroke-linecap="round">
      <path d="M32 9v6M32 49v6M9 32h6M49 32h6M15.7 15.7l4.2 4.2M44.1 44.1l4.2 4.2M15.7 48.3l4.2-4.2M44.1 19.9l4.2-4.2"></path>
    </g>
  </svg>
  <span>Season<b>Scout</b></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-weight: 650;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .logo b {
    font-weight: 800;
  }
</style>
