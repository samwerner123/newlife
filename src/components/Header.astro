---
import Logo from './Logo.astro';
import Search from './Search.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/#months', label: 'Where to go' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/countries/', label: 'Countries' },
  { href: '/compare/', label: 'Compare' },
  { href: '/guides/', label: 'Guides' },
  { href: '/trip-finder/', label: 'Trip finder' },
  { href: '/map/', label: 'Map', menuOnly: true },
  { href: '/calendar/', label: 'Calendar', menuOnly: true },
];
const current = (href: string) => href !== '/#months' && path.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <Logo />
    <nav aria-label="Main" id="main-nav" class="nav">
      <ul>
        {links.map((l) => <li class:list={{ 'menu-only': l.menuOnly }}><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
        <li class="menu-units">
          <button type="button" class="units wide" data-units-toggle>
            Units: <span data-unit-c>°C</span><span class="sep">/</span><span data-unit-f>°F</span>
          </button>
        </li>
        <li class="menu-units">
          <button type="button" class="units wide" data-theme-toggle>
            <Icon name="moon" size={18} /> Light / dark theme
          </button>
        </li>
      </ul>
    </nav>
    <div class="tools">
      <Search />
      <a class="icon-btn saved-link" href="/saved/" aria-label="Saved places" title="Saved places">
        <Icon name="heart" size={20} /><span class="count" data-saved-count hidden></span>
      </a>
      <button type="button" class="icon-btn theme" data-theme-toggle aria-label="Switch light or dark theme" title="Light / dark theme">
        <span class="t-dark"><Icon name="moon" size={20} /></span><span class="t-light"><Icon name="sun" size={20} /></span>
      </button>
      <button type="button" class="units" data-units-toggle aria-label="Switch temperature units" title="Switch °C / °F">
        <span data-unit-c>°C</span><span class="sep">/</span><span data-unit-f>°F</span>
      </button>
      <button type="button" class="menu" aria-controls="main-nav" aria-expanded="false" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Light/dark toggle: flips whatever is showing now and remembers the choice.
  const root = document.documentElement;
  document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  }));

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('main-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      nav.classList.remove('is-open');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
  }
  .nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 11px;
    border-radius: 8px;
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .menu-only {
    display: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .units,
  .menu,
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }
  .icon-btn {
    position: relative;
    padding: 0;
    text-decoration: none;
  }
  .count {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--cta);
    color: var(--cta-text);
    font-size: 0.6875rem;
    line-height: 16px;
    text-align: center;
  }
  .count[hidden] {
    display: none;
  }
  /* Show the icon for the theme you'd switch to. */
  .t-light {
    display: none;
  }
  :global(html[data-theme='dark']) .t-light {
    display: contents;
  }
  :global(html[data-theme='dark']) .t-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .t-light {
      display: contents;
    }
    :global(html:not([data-theme='light'])) .t-dark {
      display: none;
    }
  }
  .units .sep {
    color: var(--muted);
  }
  :global(html[data-units='metric']) [data-unit-c],
  :global(html[data-units='imperial']) [data-unit-f] {
    color: var(--text);
    font-weight: 800;
  }
  .menu,
  .menu-units {
    display: none;
  }
  @media (max-width: 1100px) {
    .menu-only {
      display: block;
    }
    .bar {
      min-height: 56px;
    }
    .tools {
      margin-left: auto;
    }
    .menu {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }
    .nav.is-open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      padding: 8px 16px 16px;
    }
    .nav a {
      display: flex;
      min-height: 48px;
      font-size: 1.0625rem;
      padding: 10px 12px;
    }
  }
  @media (max-width: 480px) {
    .tools > .units,
    .tools > .theme {
      display: none;
    }
    .menu-units {
      display: block;
      padding-top: 8px;
    }
    .units.wide {
      width: 100%;
      justify-content: flex-start;
      gap: 6px;
      min-height: 48px;
      padding: 0 12px;
      font-size: 1rem;
    }
  }
</style>
