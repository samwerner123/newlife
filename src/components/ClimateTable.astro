---
import RatingBadge from './RatingBadge.astro';
import { destMonthUrl, deg, type Destination } from '../lib/data';
import { crowdLevel, SEASON_SHORT } from '../lib/seasonality';

interface Props {
  dest: Destination;
  active?: number;
}

const { dest, active } = Astro.props;
const hasDays = dest.months.every((m) => m.rainDays !== null);
// Weather boxes are sometimes kept in a template; credit the article that shows it instead.
const sourcePage = dest.climateSource.page.startsWith('Template:')
  ? ([] as string[]).concat(dest.climateWiki ?? dest.wiki)[0]
  : dest.climateSource.page;
// Pages from other language editions are stored as "vi:Title".
const wikiUrl = (page: string) => {
  const [, lang = 'en', title] = page.match(/^(?:([a-z]{2,3}):)?(.+)$/)!;
  return `https://${lang}.wikipedia.org/wiki/${encodeURIComponent(title.replace(/ /g, '_'))}`;
};
const LANGS: Record<string, string> = { vi: 'Vietnamese', fr: 'French', de: 'German', es: 'Spanish', it: 'Italian', pt: 'Portuguese' };
const sourceLang = LANGS[sourcePage.match(/^([a-z]{2,3}):/)?.[1] ?? ''];
const hasSun = dest.months.every((m) => m.sunHours !== null);
const hasSea = dest.months.every((m) => m.sea !== null);
const hm = (h: number) => (h >= 24 ? '24 h' : h <= 0 ? '0 h' : `${h.toFixed(1)} h`);
---

<div class="table-wrap">
  <table class="data-table">
    <caption class="visually-hidden">{dest.name} climate averages and weather rating by month</caption>
    <thead>
      <tr>
        <th scope="col">Month</th>
        <th scope="col">Rating</th>
        <th scope="col">Season</th>
        <th scope="col">High</th>
        <th scope="col">Low</th>
        <th scope="col">Rain</th>
        {hasDays && <th scope="col">Rainy days</th>}
        {hasSun && <th scope="col">Sun / day</th>}
        <th scope="col">Daylight</th>
        {hasSea && <th scope="col">Sea</th>}
      </tr>
    </thead>
    <tbody>
      {
        dest.months.map((m) => (
          <tr class:list={{ 'is-active': m.index === active }}>
            <th scope="row"><a href={destMonthUrl(dest, m.index)}>{m.name}</a></th>
            <td><RatingBadge score={m.score} rating={m.rating} note={m.note} /></td>
            <td class="season" data-season={crowdLevel(dest, m.index)}>{SEASON_SHORT[crowdLevel(dest, m.index)]}</td>
            <td>{deg(m.high)}</td>
            <td>{deg(m.low)}</td>
            <td>{m.rain} mm</td>
            {hasDays && <td>{Math.round(m.rainDays!)}</td>}
            {hasSun && <td>{m.sunHours!.toFixed(1)} h</td>}
            <td>{hm(m.daylight)}</td>
            {hasSea && <td>{deg(m.sea!)}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="disclosure source">
  Season is our estimate of crowds and prices, from the weather, holidays and events (<a href="/about/#seasons">how we estimate it</a>).
  Source: {dest.climateSource.location} — via the{' '}
  <a href={wikiUrl(sourcePage)} rel="noopener">{sourcePage.replace(/^[a-z]{2,3}:/, '')}</a>{' '}
  article on {sourceLang ? `the ${sourceLang} ` : ''}Wikipedia (CC BY-SA){dest.climateSource.rain === 'nasa-power' ? '; rainfall from NASA POWER' : ''}.{' '}
  {hasDays && dest.climateSource.rainDaysUnit && `Rainy days count days with at least ${dest.climateSource.rainDaysUnit.replace(/&nbsp;/g, ' ')} of rain. `}
  Daylight is the average time from sunrise to sunset, calculated from the latitude.{' '}
  {hasSea && 'Sea temperatures are average sea-surface temperatures for 2023–2025 from the Open-Meteo Marine API.'}
</p>

<style>
  th[scope='row'] {
    font-weight: 600;
  }
  th[scope='row'] a {
    color: var(--text);
  }
  tr.is-active td,
  tr.is-active th {
    background: var(--surface-2);
  }
  .source {
    margin-top: 8px;
  }
</style>
