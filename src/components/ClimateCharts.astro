---
// Two single-series charts sharing the month axis (never a dual axis):
// temperature range (low→high) and rainfall. Built in HTML/CSS so labels stay
// readable at any width; the table below is the full accessible equivalent.
import { deg, plural, type Destination } from '../lib/data';

interface Props {
  dest: Destination;
  active?: number;
}

const { dest, active } = Astro.props;
const ms = dest.months;

function niceTicks(min: number, max: number, target = 4) {
  const span = max - min;
  const step = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500].find((s) => span / s <= target) ?? 1000;
  const lo = Math.floor(min / step) * step;
  const hi = Math.ceil(max / step) * step;
  const ticks: number[] = [];
  for (let v = lo; v <= hi + 1e-9; v += step) ticks.push(v);
  return { lo, hi, ticks };
}

const t = niceTicks(Math.min(...ms.map((m) => m.low)), Math.max(...ms.map((m) => m.high)));
const tPct = (v: number) => ((v - t.lo) / (t.hi - t.lo)) * 100;
const hottest = ms.reduce((a, b) => (b.high > a.high ? b : a)).index;
const coldest = ms.reduce((a, b) => (b.low < a.low ? b : a)).index;

const r = niceTicks(0, Math.max(50, ...ms.map((m) => m.rain)));
const rPct = (v: number) => (v / r.hi) * 100;
const wettest = ms.reduce((a, b) => (b.rain > a.rain ? b : a)).index;
---

<div class="charts">
  <figure class="chart">
    <figcaption>Average daily high and low, °C</figcaption>
    <div class="plot">
      <div class="grid" aria-hidden="true">
        {t.ticks.map((v) => <span class:list={{ zero: v === 0 }} style={`bottom:${tPct(v)}%`}><em>{v}°</em></span>)}
      </div>
      <ol class="cols">
        {
          ms.map((m) => (
            <li
              class:list={['col', { 'is-active': m.index === active }]}
              tabindex="0"
              data-tip={`${m.name}\nHigh ${deg(m.high)} · Low ${deg(m.low)}`}
              aria-label={`${m.name}: high ${deg(m.high)}, low ${deg(m.low)}`}
            >
              <span class="bar temp" style={`bottom:${tPct(m.low)}%;top:${100 - tPct(m.high)}%`} />
              {m.index === hottest && <span class="val" style={`bottom:calc(${tPct(m.high)}% + 4px)`}>{deg(m.high)}</span>}
              {m.index === coldest && <span class="val below" style={`top:calc(${100 - tPct(m.low)}% + 4px)`}>{deg(m.low)}</span>}
            </li>
          ))
        }
      </ol>
    </div>
    <ol class="x" aria-hidden="true">{ms.map((m) => <li class:list={{ 'is-active': m.index === active }}>{m.short}</li>)}</ol>
  </figure>

  <figure class="chart">
    <figcaption>Average monthly rainfall, mm</figcaption>
    <div class="plot">
      <div class="grid" aria-hidden="true">
        {r.ticks.map((v) => <span class:list={{ zero: v === 0 }} style={`bottom:${rPct(v)}%`}><em>{v}</em></span>)}
      </div>
      <ol class="cols">
        {
          ms.map((m) => (
            <li
              class:list={['col', { 'is-active': m.index === active }]}
              tabindex="0"
              data-tip={`${m.name}\n${m.rain} mm rain${m.rainDays !== null ? ` · ${plural(m.rainDays, 'rainy day')}` : ''}`}
              aria-label={`${m.name}: ${m.rain} millimetres of rain`}
            >
              <span class="bar rain" style={`bottom:0;height:${Math.max(rPct(m.rain), m.rain > 0 ? 1 : 0)}%`} />
              {m.index === wettest && <span class="val" style={`bottom:calc(${rPct(m.rain)}% + 4px)`}>{m.rain}</span>}
            </li>
          ))
        }
      </ol>
    </div>
    <ol class="x" aria-hidden="true">{ms.map((m) => <li class:list={{ 'is-active': m.index === active }}>{m.short}</li>)}</ol>
  </figure>
</div>

<style>
  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }
  .chart {
    margin: 0;
    padding: 16px 16px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  figcaption {
    font-weight: 650;
    font-size: 0.9375rem;
    margin-bottom: 14px;
  }
  .plot {
    position: relative;
    height: 180px;
    margin-left: 34px;
    margin-top: 18px;
  }
  .grid span {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px solid var(--grid);
  }
  .grid span.zero {
    border-top-color: var(--axis);
  }
  .grid em {
    position: absolute;
    right: calc(100% + 6px);
    top: -0.6em;
    font-style: normal;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .cols,
  .x {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }
  .cols {
    position: absolute;
    inset: 0;
  }
  .col {
    position: relative;
    border-radius: 6px;
    outline-offset: 0;
  }
  .col.is-active {
    background: var(--surface-2);
  }
  .col:hover .bar {
    filter: brightness(1.12);
  }
  .bar {
    position: absolute;
    left: 50%;
    width: min(22px, 62%);
    transform: translateX(-50%);
  }
  .temp {
    background: var(--temp);
    border-radius: 4px;
  }
  .rain {
    background: var(--rain);
    border-radius: 4px 4px 0 0;
  }
  .val {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--text);
    white-space: nowrap;
  }
  .x {
    margin-left: 34px;
    margin-top: 6px;
  }
  .x li {
    text-align: center;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .x li.is-active {
    color: var(--text);
    font-weight: 700;
  }
  @media (max-width: 420px) {
    .x li {
      font-size: 0.625rem;
      letter-spacing: -0.02em;
    }
  }
</style>
