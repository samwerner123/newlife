---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import BookingBox from './BookingBox.astro';
import DestinationCard from './DestinationCard.astro';
import MonthPills from './MonthPills.astro';
import Photo from './Photo.astro';
import RatingBadge from './RatingBadge.astro';
import Faq from './Faq.astro';
import { hubs, rankForMonth, hubMonthUrl, destMonthUrl, monthUrl, packingTips, travelYear, MONTHS, deg, type Hub } from '../lib/data';
import { RATING_LABEL } from '../lib/score';
import { breadcrumbLd } from '../lib/seo';
import { faqLd } from '../lib/faq';
import { ogImage } from '../lib/images';

interface Props {
  hub: Hub;
  m: number;
}

const { hub, m } = Astro.props;
const mn = MONTHS[m];
const hm = hub.months[m];
const ranked = rankForMonth(m, hub.members);
const best = ranked[0];
const worst = ranked[ranked.length - 1];
const events = hub.members.filter((d) => d.months[m].event).map((d) => ({ d, text: d.months[m].event! }));
const notes = hub.members.filter((d) => d.months[m].note).map((d) => ({ d, text: d.months[m].note! }));
const others = hubs
  .filter((h) => h.name !== hub.name && h.months[m].score > hm.score)
  .sort((a, b) => b.months[m].score - a.months[m].score)
  .slice(0, 4);
const opener = {
  great: `${mn} is one of the best times to visit ${hub.label}.`,
  good: `${mn} is a good time to visit ${hub.label}.`,
  fair: `${mn} is a mixed month in ${hub.label} — pick your destination carefully.`,
  poor: `${mn} isn't the best time for most of ${hub.label}.`,
}[hm.rating];
const lead = `${opener} The best weather is in ${best.name} (${RATING_LABEL[best.months[m].rating].toLowerCase()}, ${deg(best.months[m].high)}), while ${worst.name} rates ${RATING_LABEL[worst.months[m].rating].toLowerCase()}.`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: `Best time to visit ${hub.label}`, href: hub.url },
  { name: `${hub.Label} in ${mn}`, href: hubMonthUrl(hub, m) },
];
const faq = [
  { q: `Is ${mn} a good time to visit ${hub.label}?`, a: `${opener} Across our ${hub.members.length} ${hub.name} destinations the average weather score is ${hm.score}/100.` },
  { q: `Where is the best weather in ${hub.label} in ${mn}?`, a: `${best.name}: average highs of ${deg(best.months[m].high)}, lows of ${deg(best.months[m].low)} and ${best.months[m].rain} mm of rain.` },
  { q: `Does it rain in ${hub.label} in ${mn}?`, a: `Rainfall varies from ${Math.min(...hub.members.map((d) => d.months[m].rain))} mm to ${Math.max(...hub.members.map((d) => d.months[m].rain))} mm across ${hub.label} in ${mn}, averaging ${hm.rain} mm.` },
];
const title = `${hub.Label} in ${mn} ${travelYear(m)}: Weather & Where to Go`;
const description = `${hub.Label} in ${mn}: ${opener} Weather for ${hub.members.map((d) => d.name).join(', ')} — temperatures, rain and the best place to go.`;
---

<Base title={title} description={description} jsonLd={[breadcrumbLd(crumbs, Astro.site), faqLd(faq)]} ogType="article" image={await ogImage(best.slug)}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="section-tight">
      <p class="eyebrow">{hub.name} travel guide · {mn}</p>
      <h1>{hub.Label} in {mn}</h1>
      <p class="lead">{lead}</p>
    </header>
    <Photo slug={best.slug} alt={`${best.name}, ${hub.name}`} variant="hero" />

    <ul class="tiles" aria-label={`${hub.Label} in ${mn} at a glance`}>
      <li class="card tile"><span class="label">Overall</span><span class="value"><RatingBadge score={hm.score} rating={hm.rating} /></span></li>
      <li class="card tile"><span class="label">Best place</span><span class="value small-v"><a href={destMonthUrl(best, m)}>{best.name}</a></span></li>
      <li class="card tile"><span class="label">Avg high / low</span><span class="value">{deg(hm.high)}<small> / {deg(hm.low)}</small></span></li>
      <li class="card tile"><span class="label">Avg rainfall</span><span class="value">{hm.rain}<small> mm</small></span></li>
    </ul>

    <div class="layout">
      <div class="main">
        <section>
          <h2>{hub.name} weather in {mn}, by destination</h2>
          <div class="table-wrap">
            <table class="data-table">
              <caption class="visually-hidden">{hub.name} destinations in {mn}</caption>
              <thead><tr><th scope="col">Destination</th><th scope="col">Rating</th><th scope="col">High / low</th><th scope="col">Rain</th></tr></thead>
              <tbody>
                {ranked.map((d) => (
                  <tr>
                    <th scope="row"><a href={destMonthUrl(d, m)}>{d.name}</a></th>
                    <td><RatingBadge score={d.months[m].score} rating={d.months[m].rating} note={d.months[m].note} /></td>
                    <td>{deg(d.months[m].high)} / {deg(d.months[m].low)}</td>
                    <td>{d.months[m].rain} mm</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {
          (events.length > 0 || notes.length > 0) && (
            <section class="prose">
              <h2>What's on in {mn}</h2>
              <ul>
                {events.map((e) => <li><b>{e.d.name}:</b> {e.text}</li>)}
                {notes.map((e) => <li><b>{e.d.name}:</b> {e.text}.</li>)}
              </ul>
            </section>
          )
        }

        <section class="prose">
          <h2>What to pack for {hub.label} in {mn}</h2>
          <ul>{packingTips(best, best.months[m]).map((t) => <li>{t}</li>)}</ul>
        </section>
      </div>
      <aside class="side">
        <div class="sticky">
          <BookingBox title={`Book your ${mn} trip to ${hub.label}`} />
        </div>
      </aside>
    </div>

    <section class="section">
      <h2>{hub.name} destinations ranked for {mn}</h2>
      <div class="grid-cards">{ranked.map((d, i) => <DestinationCard dest={d} month={m} rank={i + 1} />)}</div>
    </section>

    {
      others.length > 0 && (
        <section class="section-tight">
          <h2>Better weather elsewhere in {mn}</h2>
          <div class="chips">
            {others.map((h) => <a class="chip" href={hubMonthUrl(h, m)}>{h.Label} in {mn} · {h.months[m].score}</a>)}
            <a class="chip" href={monthUrl(m)}>All {mn} ideas</a>
          </div>
        </section>
      )
    }

    <Faq items={faq} />

    <section class="section">
      <h2 class="h3">{hub.Label} in other months</h2>
      <MonthPills hrefs={MONTHS.map((_, i) => hubMonthUrl(hub, i))} active={m} label={`${hub.Label} by month`} />
      <p><a href={hub.url}>Best time to visit {hub.label} →</a></p>
    </section>
  </div>
</Base>

<style>
  .tiles {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
  }
  .label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-2);
  }
  .value {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .small-v {
    font-size: 1.1rem;
  }
  .value small {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 24px;
    align-items: start;
    margin-top: 24px;
  }
  .main {
    display: grid;
    gap: 24px;
    min-width: 0;
  }
  .main > *,
  .side {
    min-width: 0;
  }
  .sticky {
    position: sticky;
    top: 76px;
  }
  th[scope='row'] a {
    color: var(--text);
    font-weight: 600;
  }
  .h3 {
    font-size: 1.15rem;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .sticky {
      position: static;
    }
  }
</style>
