---
import '../styles/global.css';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  /** Site-relative or absolute URL of a JPEG/PNG used for social previews. */
  image?: string;
  /** Destination slug to remember in the visitor's "recently viewed" list. */
  recent?: string;
  /** Keep the page out of search results (tools that only work with JavaScript, embeds). */
  noindex?: boolean;
}

const { title, description, jsonLd = [], ogType = 'website', image, recent, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Keep titles short enough for search results: drop the brand suffix on long titles.
const fullTitle = title.includes(SITE.name) || title.length > 52 ? title : `${title} | ${SITE.name}`;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Units preference before first paint: saved choice, else °F for US English browsers.
      (function () {
        var u = null;
        try { u = localStorage.getItem('units'); } catch (e) {}
        if (u !== 'metric' && u !== 'imperial') u = /^en-(US|LR)$/i.test(navigator.language || '') ? 'imperial' : 'metric';
        document.documentElement.setAttribute('data-units', u);
        // Theme chosen with the header toggle (otherwise the system setting applies).
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body data-recent={recent}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div id="tip" role="tooltip" aria-hidden="true"></div>
    <script>
      // Converts the server-rendered metric values (°C, mm) when the visitor prefers imperial units.
      const root = document.documentElement;
      const toF = (c: number) => Math.round((c * 9) / 5 + 32);
      const toIn = (mm: number) => (mm / 25.4).toFixed(mm >= 254 ? 0 : 1);
      // Handles single values (21°C), ranges (24–30°C, -5 to -20°C), the typographic minus (−5°C) and
      // differences ("3°C warmer"), which scale by 9/5 without the +32 offset.
      const num = (x: string) => +x.replace('−', '-');
      const conv = (s: string) =>
        s
          .replace(/(\d+(?:\.\d+)?)°C (warmer|cooler|colder|hotter)/g, (_, c, w) => `${Math.round((num(c) * 9) / 5)}°F ${w}`)
          .replace(/([−-]?\d+(?:\.\d+)?)(\s?[–-]\s?|\sto\s)([−-]?\d+(?:\.\d+)?)°C/g, (_, a, sep, b) => `${toF(num(a))}${sep}${toF(num(b))}°F`)
          .replace(/([−-]?\d+(?:\.\d+)?)°C/g, (_, c) => `${toF(num(c))}°F`)
          .replace(/(\d+(?:\.\d+)?)(\s?)mm\b/g, (_, mm, sp) => `${toIn(+mm)}${sp}in`)
          .replace(/°C/g, '°F')
          .replace(/, mm\b/g, ', in');

      function convert(el: ParentNode) {
        for (const n of el.querySelectorAll<HTMLElement>('[data-u]')) {
          const v = Number(n.dataset.v);
          n.textContent = n.dataset.u === 'c' ? `${toF(v)}°` : `${toIn(v)}`;
        }
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
          acceptNode: (t) =>
            t.parentElement?.closest('script,style,[data-u],[data-no-units]') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT,
        });
        const texts: Text[] = [];
        while (walker.nextNode()) texts.push(walker.currentNode as Text);
        for (const t of texts) {
          if (/°C|mm\b/.test(t.data)) t.data = conv(t.data);
        }
        for (const n of el.querySelectorAll<HTMLElement>('[data-tip],[aria-label],[title]')) {
          if (n.closest('[data-no-units]')) continue;
          for (const a of ['data-tip', 'aria-label', 'title']) {
            const v = n.getAttribute(a);
            if (v && /°C|mm\b/.test(v)) n.setAttribute(a, conv(v));
          }
        }
      }

      if (root.dataset.units === 'imperial') convert(document.body);
      (window as unknown as { __convertUnits: typeof convert }).__convertUnits = (el) => {
        if (root.dataset.units === 'imperial') convert(el);
      };
      document.querySelectorAll('[data-units-toggle]').forEach((b) => b.addEventListener('click', () => {
        const next = root.dataset.units === 'imperial' ? 'metric' : 'imperial';
        try {
          localStorage.setItem('units', next);
        } catch {}
        location.reload();
      }));
    </script>
    <script>
      // Saved places and recently viewed destinations live in localStorage (nothing leaves the browser).
      const read = (k: string): string[] => {
        try {
          return JSON.parse(localStorage.getItem(k) || '[]');
        } catch {
          return [];
        }
      };
      const write = (k: string, v: string[]) => {
        try {
          localStorage.setItem(k, JSON.stringify(v));
        } catch {}
      };
      function paintSaved() {
        const saved = read('saved');
        document.querySelectorAll<HTMLElement>('[data-save]').forEach((b) => {
          const on = saved.includes(b.dataset.save!);
          b.setAttribute('aria-pressed', String(on));
          const label = b.querySelector('[data-save-label]');
          if (label) label.textContent = on ? 'Saved' : 'Save';
        });
        document.querySelectorAll<HTMLElement>('[data-saved-count]').forEach((c) => {
          c.textContent = saved.length ? String(saved.length) : '';
          c.hidden = !saved.length;
        });
      }
      document.addEventListener('click', (e) => {
        const b = (e.target as Element | null)?.closest?.('[data-save]') as HTMLElement | null;
        if (!b) return;
        e.preventDefault();
        const slug = b.dataset.save!;
        const saved = read('saved');
        write('saved', saved.includes(slug) ? saved.filter((s) => s !== slug) : [slug, ...saved]);
        paintSaved();
      });
      paintSaved();
      if ('serviceWorker' in navigator && location.protocol === 'https:') navigator.serviceWorker.register('/sw.js').catch(() => {});
      const recent = document.body.dataset.recent;
      if (recent) write('recent', [recent, ...read('recent').filter((s) => s !== recent)].slice(0, 12));
    </script>
    <script>
      // One shared tooltip for every element carrying data-tip ("first line\nmore lines").
      // Values come from our own data, but we still build the DOM with textContent.
      const tip = document.getElementById('tip')!;
      let active: HTMLElement | null = null;

      function show(el: HTMLElement, x?: number, y?: number) {
        const text = el.dataset.tip;
        if (!text) return;
        if (active !== el) {
          const [first, ...rest] = text.split('\n');
          const strong = document.createElement('strong');
          strong.textContent = first;
          tip.replaceChildren(strong, document.createTextNode(rest.join('\n')));
          active = el;
        }
        const r = el.getBoundingClientRect();
        const px = x ?? r.left + r.width / 2;
        const py = y ?? r.top;
        const w = tip.offsetWidth;
        const h = tip.offsetHeight;
        const left = Math.min(window.innerWidth - w - 8, Math.max(8, px - w / 2));
        const top = py - h - 12 < 8 ? py + 20 : py - h - 12;
        tip.style.left = `${left}px`;
        tip.style.top = `${top}px`;
        tip.classList.add('is-on');
      }

      function hide() {
        tip.classList.remove('is-on');
        active = null;
      }

      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element | null)?.closest?.('[data-tip]') as HTMLElement | null;
        if (el && e.pointerType !== 'touch') show(el, e.clientX, e.clientY);
        else if (active) hide();
      });
      document.addEventListener('focusin', (e) => {
        const el = (e.target as Element | null)?.closest?.('[data-tip]') as HTMLElement | null;
        if (el) show(el);
      });
      document.addEventListener('focusout', hide);
      window.addEventListener('scroll', hide, { passive: true });
    </script>
    <style>
      .skip {
        position: absolute;
        left: -999px;
        top: 8px;
        background: var(--surface);
        padding: 8px 12px;
        border-radius: 8px;
        z-index: 100;
      }
      .skip:focus {
        left: 8px;
      }
    </style>
  </body>
</html>
