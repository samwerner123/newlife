---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Filters from '../../components/Filters.astro';
import { destinations } from '../../lib/data';
import { breadcrumbLd } from '../../lib/seo';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Destinations', href: '/destinations/' },
];
const sorted = [...destinations].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="All Destinations: Best Time to Visit, Weather and Budgets"
  description={`Best time to visit ${destinations.length} popular destinations in Europe, Asia, Africa and the Americas — month-by-month weather ratings and daily budgets.`}
  jsonLd={[breadcrumbLd(crumbs, Astro.site)]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="section-tight">
      <h1>All destinations</h1>
      <p class="lead">
        {destinations.length} places rated for every month of the year. Pick a destination to see its best months, climate
        charts and costs.
      </p>
    </header>
    <Filters target="#all-list" fields={['region', 'budget', 'sort']} defaultSort="name" />
    <h2 class="visually-hidden">All destinations</h2>
    <div class="grid-cards" id="all-list">
      {sorted.map((d, i) => <DestinationCard dest={d} eager={i === 0} />)}
    </div>
    <p class="card" data-empty hidden>No destinations match — try another region or budget.</p>
  </div>
</Base>
