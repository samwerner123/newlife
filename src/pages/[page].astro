---
// Top-level programmatic pages that match high-demand searches:
//  - month collections, e.g. /warm-places-to-visit-in-december/
//  - country/state by month, e.g. /thailand-in-december/
import CollectionView from '../components/CollectionView.astro';
import HubMonthView from '../components/HubMonthView.astro';
import { COLLECTIONS, type Collection } from '../lib/collections';
import { hubs, hubMonthUrl, MONTHS, type Hub } from '../lib/data';

type P = { kind: 'collection'; collection: Collection; m: number } | { kind: 'hubmonth'; hub: Hub; m: number };

export function getStaticPaths() {
  // A collection page is only built when it has destinations to show.
  const fromCollections = COLLECTIONS.flatMap((collection) =>
    MONTHS.map((_, m) => m)
      .filter((m) => collection.pick(m).length > 0)
      .map((m) => ({ params: { page: collection.path(m).slice(1, -1) }, props: { kind: 'collection', collection, m } })),
  );
  const fromHubs = hubs.flatMap((hub) =>
    MONTHS.map((_, m) => ({ params: { page: hubMonthUrl(hub, m).slice(1, -1) }, props: { kind: 'hubmonth', hub, m } })),
  );
  return [...fromCollections, ...fromHubs];
}

const p = Astro.props as P;
---

{p.kind === 'collection' ? <CollectionView collection={p.collection} m={p.m} /> : <HubMonthView hub={p.hub} m={p.m} />}
