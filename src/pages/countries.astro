---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import { hubs, destinations, monthRanges, MONTH_SHORT, REGIONS } from '../lib/data';
import { breadcrumbLd } from '../lib/seo';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Countries & regions', href: '/countries/' },
];
// Countries and islands that people search for directly but that we cover with a single destination page.
const SINGLES = ['iceland', 'ireland', 'switzerland', 'malta', 'fiji', 'maldives', 'mauritius', 'seychelles', 'aruba', 'turks-and-caicos', 'bahamas', 'jamaica', 'puerto-rico', 'punta-cana', 'singapore', 'hong-kong', 'taiwan', 'sri-lanka', 'bali', 'zanzibar', 'galapagos', 'bora-bora', 'dubai'];
const singles = destinations.filter((d) => SINGLES.includes(d.slug));
const all = [
  ...hubs.map((h) => ({ name: h.name, url: h.url, photo: h.members[0].slug, best: h.bestMonths, region: h.members[0].region, sub: `${h.members.length} destinations` })),
  ...singles.map((d) => ({ name: d.name, url: d.url, photo: d.slug, best: d.bestMonths, region: d.region, sub: d.tagline })),
];
---

<Base
  title="Best Time to Visit: Countries, States & Islands"
  description={`When to visit ${all.length} countries, states and islands — from Hawaii and Japan to Thailand, Greece and the Caribbean — with month-by-month weather.`}
  jsonLd={[breadcrumbLd(crumbs, Astro.site)]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="section-tight">
      <h1>Best time to visit: countries &amp; regions</h1>
      <p class="lead">Pick a country, state or island to see when the weather is best — and which part to head for each month.</p>
    </header>
    {
      REGIONS.map((r) => {
        const items = all.filter((x) => x.region === r).sort((a, b) => a.name.localeCompare(b.name));
        return items.length ? (
          <section class="section-tight">
            <h2>{r}</h2>
            <div class="grid">
              {items.map((x) => (
                <a class="card tile" href={x.url}>
                  <Photo slug={x.photo} alt="" variant="card" />
                  <div class="body">
                    <h3>{x.name}</h3>
                    <p class="small"><b>Best:</b> {monthRanges(x.best, MONTH_SHORT) || '—'}</p>
                    <p class="small muted">{x.sub}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ) : null;
      })
    }
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 14px;
  }
  .tile {
    padding: 0;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
  }
  .tile:hover {
    box-shadow: var(--shadow);
  }
  .body {
    padding: 12px 14px;
  }
  h3 {
    margin: 0 0 4px;
    font-size: 1.05rem;
  }
  .body p {
    margin: 0 0 2px;
  }
  @media (max-width: 420px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .body {
      padding: 10px;
    }
    h3 {
      font-size: 0.95rem;
    }
  }
</style>
