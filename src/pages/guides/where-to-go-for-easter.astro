---
import Guide from '../../layouts/Guide.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import { bySlug, rankForMonth, destMonthUrl, deg } from '../../lib/data';

// Easter Sunday 2027 is 28 March (Holy Week 21–28 March); Orthodox Easter is 2 May 2027.
const traditions: { slug: string; name: string; m: number; what: string }[] = [
  { slug: 'seville', name: 'Seville', m: 2, what: 'Semana Santa at its most spectacular: around 60 brotherhoods carry floats through the streets day and night from Palm Sunday (21 March 2027).' },
  { slug: 'granada', name: 'Granada', m: 2, what: 'Holy Week processions against the backdrop of the Alhambra, including the Sacromonte procession lit by bonfires.' },
  { slug: 'antigua-guatemala', name: 'Antigua, Guatemala', m: 2, what: 'The most famous Semana Santa in the Americas, with streets carpeted in coloured sawdust and flowers for the processions.' },
  { slug: 'rome', name: 'Rome & the Vatican', m: 2, what: 'Holy Week services, the Way of the Cross at the Colosseum on Good Friday and the Pope’s Easter blessing in St Peter’s Square.' },
  { slug: 'florence', name: 'Florence', m: 2, what: 'Scoppio del Carro on Easter Sunday morning: a cart packed with fireworks is set off outside the cathedral.' },
  { slug: 'malta', name: 'Malta', m: 2, what: 'Good Friday processions in towns across the islands and Easter Sunday runs with the statue of the Risen Christ.' },
  { slug: 'san-miguel-de-allende', name: 'San Miguel de Allende', m: 2, what: 'Processions, altars and re-enactments all week; Holy Week is a national holiday in Mexico, so beaches fill up.' },
  { slug: 'bermuda', name: 'Bermuda', m: 2, what: 'Good Friday kite-flying, with homemade kites, fish cakes and hot cross buns.' },
  { slug: 'corfu', name: 'Corfu (Orthodox Easter, 2 May 2027)', m: 4, what: 'Islanders throw clay pots from their balconies on Holy Saturday, followed by midnight fireworks.' },
  { slug: 'cyprus', name: 'Cyprus & Greece (Orthodox Easter)', m: 4, what: 'Candlelit midnight services, fireworks and spit-roast lamb on Easter Sunday.' },
];
const rows = traditions.map((t) => ({ ...t, d: bySlug.get(t.slug)! }));
const warm = rankForMonth(2).filter((d) => d.months[2].high >= 25).slice(0, 8);
const april = rankForMonth(3).slice(0, 8);
---

<Guide slug="where-to-go-for-easter" photo="seville">
  <p>
    In 2027, <strong>Easter Sunday falls on 28 March</strong>, early in the year, so Holy Week runs from Palm Sunday on
    21 March to Easter Monday on 29 March. Orthodox Easter, celebrated in Greece and Cyprus, is five weeks later, on
    <strong>2 May 2027</strong>. Easter is a great time to travel for spring weather, festivals and processions — but it's also a
    school-holiday week in much of Europe and Latin America, so book early.
  </p>

  <h2>Where to see Easter traditions</h2>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th scope="col">Where</th><th scope="col" class="left">What happens</th><th scope="col">Weather</th></tr></thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row"><a href={r.d.url}>{r.name}</a></th>
              <td class="left">{r.what}</td>
              <td>
                <a href={destMonthUrl(r.d, r.m)}>{deg(r.d.months[r.m].high)}</a> <RatingBadge score={r.d.months[r.m].score} rating={r.d.months[r.m].rating} note={r.d.months[r.m].note} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="small muted">Weather is the average for March (May for Orthodox Easter), from official climate normals.</p>

  <h2>Warm places for an Easter break</h2>
  <p>
    Late March is still cool in northern Europe and North America. For guaranteed warmth, these destinations rate best in March
    with highs of 25°C or more:
  </p>
  <ul class="picks">
    {warm.map((d) => (
      <li>
        <a href={destMonthUrl(d, 2)}>{d.name}</a> <RatingBadge score={d.months[2].score} rating={d.months[2].rating} note={d.months[2].note} />
        <span class="muted small">{deg(d.months[2].high)} · {d.country}</span>
      </li>
    ))}
  </ul>
  <p>
    If your Easter break runs into April, these are the best-rated destinations for April:
    {april.map((d, i) => <>{i > 0 && ', '}<a href={destMonthUrl(d, 3)}>{d.name}</a></>)}.
  </p>

  <h2>Easter city breaks in Europe</h2>
  <p>
    Spring is a lovely time for Europe's cities: Prague, Vienna and Kraków hold Easter markets with painted eggs and spring
    food, and southern cities like Seville, Lisbon and Rome are pleasantly warm. Expect crowds at the big religious sites in
    Holy Week, and some museums and shops closed on Good Friday or Easter Monday.
  </p>

  <h2>Tips</h2>
  <ul>
    <li><b>Book early:</b> Seville and Antigua sell out months ahead of Holy Week, and Mexican beach resorts are full of domestic travellers.</li>
    <li><b>Check opening hours:</b> Good Friday and Easter Monday are public holidays in much of Europe.</li>
    <li><b>Respect the processions:</b> don't cross a procession's path, and dress modestly in churches.</li>
    <li>See also <a href="/where-to-go-in-march/">where to go in March</a>, <a href="/where-to-go-in-april/">where to go in April</a> and our <a href="/guides/spring-break/">spring break guide</a>.</li>
  </ul>
</Guide>

<style>
  .picks {
    list-style: none;
    padding: 0;
    margin: 0 0 6px;
    display: grid;
    gap: 6px;
  }
  .picks li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
</style>
