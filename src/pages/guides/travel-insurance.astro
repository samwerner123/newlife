            <Icon name={l.kind} size={18} /> {l.cta}
          </a>
        ))}
        <p class="disclosure">Affiliate link — we may earn a commission at no extra cost to you. <a href="/affiliate-disclosure/">How affiliate links work</a></p>
      </div>
